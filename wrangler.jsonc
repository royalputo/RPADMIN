{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rpadmin",
  "compatibility_date": "2025-11-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}

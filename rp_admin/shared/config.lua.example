-- RpAdmin connector configuration — Dev By Royalputo
-- Copy this file to shared/config.lua and fill in the values from the panel.
-- NEVER commit the real config.lua to git.

RP_ADMIN = {
  -- RpAdmin site URL (no trailing slash). Supabase is never contacted directly.
  url = "https://rpadmin.mtarg.xyz",

  -- Server key generated by the panel (shown once)
  serverKey = "rsk_...",

  -- short_id used in the panel URL (https://rpadmin.mtarg.xyz/<serverId>)
  serverId = "1",

  -- servers.id (uuid) used by PostgREST filters
  serverUuid = "00000000-0000-0000-0000-000000000000",

  -- Public panel base URL (used by /panel and the status label)
  panelUrl = "https://rpadmin.mtarg.xyz",

  -- Timings (milliseconds)
  pollInterval = 3000,
  snapshotInterval = 20000,
  eventFlushInterval = 5000,

  -- Path to the MTA server log. MUST be an ABSOLUTE path - fileOpen resolves
  -- relative paths against this resource's own folder, so 'logs/server.log'
  -- will never find the real log. When set, the tail forwards server-level
  -- ERROR/WARNING lines (resource-load failures etc.) and backfills the last
  -- 128 KB on startup. Windows example:
  --   "D:/MTA/server/mods/deathmatch/logs/server.log"
  -- Linux example: "/home/mta/server/mods/deathmatch/logs/server.log"
  -- Leave empty to disable the tail.
  logTailInterval = 5000,

  -- Forward player chat to the activity log
  logChat = true,

  -- Small in-game status label for staff (bottom-right)
  showStatusLabel = true,

  -- Verbose connector logging to the server console
  debug = false,
}
